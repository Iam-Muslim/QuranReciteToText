{
  "absolute_raw_transcriptions": [
    {
      "chunk": 1,
      "chunk_start_time_seconds": 0.024,
      "raw_text": "م اللَّهِ الرحمن الرحيم موسوعة"
    },
    {
      "chunk": 2,
      "chunk_start_time_seconds": 5.4,
      "raw_text": "وَالطِّور"
    },
    {
      "chunk": 3,
      "chunk_start_time_seconds": 9.72,
      "raw_text": "وَكِتَابٍ مَسْتُور"
    },
    {
      "chunk": 4,
      "chunk_start_time_seconds": 13.816,
      "raw_text": "فِي رك"
    },
    {
      "chunk": 5,
      "chunk_start_time_seconds": 14.552,
      "raw_text": "وََرَقٍّ مَّنشُورٍ"
    },
    {
      "chunk": 6,
      "chunk_start_time_seconds": 17.976,
      "raw_text": "وَالْبَيْتِ الْمَعْمُورِ"
    },
    {
      "chunk": 7,
      "chunk_start_time_seconds": 21.912,
      "raw_text": ""
    },
    {
      "chunk": 8,
      "chunk_start_time_seconds": 22.264,
      "raw_text": "وَالسَّقْفِ الْمَرْفُوعِ"
    },
    {
      "chunk": 9,
      "chunk_start_time_seconds": 25.432,
      "raw_text": "وَالْبَحْرِ الْمَسْجُور"
    },
    {
      "chunk": 10,
      "chunk_start_time_seconds": 29.752,
      "raw_text": "إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ"
    },
    {
      "chunk": 11,
      "chunk_start_time_seconds": 34.968,
      "raw_text": "إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ"
    },
    {
      "chunk": 12,
      "chunk_start_time_seconds": 39.416,
      "raw_text": "مَا لَهُ مِنْ دافٍِ"
    },
    {
      "chunk": 13,
      "chunk_start_time_seconds": 42.52,
      "raw_text": "يَوْمَ تَمُورُ السَّمَاءُ مَوْرًا وَتَسِيرُ الْجِبَالُ سَيْرًا فَوَيْلٌ يَوْمَئِذٍ لِِّلْمُكَذِّبِينَ الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ يَوْمَ يُدَعُّونَ إِلَى نَارِ جَهَنَّمَ دَعًّا"
    },
    {
      "chunk": 14,
      "chunk_start_time_seconds": 67.448,
      "raw_text": "هَذِهِ النَّارُ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ أَفَسِحْرٌ هَذَا أَمْ أَنْنتُمْ لَا تُبْصِرُونَ اصْلَوْهَا فَاصْبِرُوا أَوْ لَا تَصْبِرُوا سَوَاءٌ عَلَيْكُمْ إِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ"
    },
    {
      "chunk": 15,
      "chunk_start_time_seconds": 100.824,
      "raw_text": "إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَعِيم"
    },
    {
      "chunk": 16,
      "chunk_start_time_seconds": 108.376,
      "raw_text": "فَاكِهِينَ بِمَا آتَاهُمْ رَبُّهُمْ وَوَقَاهُمْ رَبُّهُمْ عَذَابَ الْجَحِيمِ"
    },
    {
      "chunk": 17,
      "chunk_start_time_seconds": 119.064,
      "raw_text": "كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ"
    },
    {
      "chunk": 18,
      "chunk_start_time_seconds": 127.768,
      "raw_text": "مُتَّكِئِينَ عَلَى سُرُرٍ مَصْفُوفَةٍ"
    },
    {
      "chunk": 19,
      "chunk_start_time_seconds": 132.92,
      "raw_text": "وَزَوَّجْنَاهُمْ بِحُورٍ عِينٍ"
    },
    {
      "chunk": 20,
      "chunk_start_time_seconds": 138.424,
      "raw_text": "وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنِّْ عَمَلِهِمْ مِنْ شَيْءٍ"
    },
    {
      "chunk": 21,
      "chunk_start_time_seconds": 161.016,
      "raw_text": "كُلُّ امْرِئٍ بِمَا كس رَهين كُلُّ امْرِئٍ بِمَا كَس رَهين"
    },
    {
      "chunk": 22,
      "chunk_start_time_seconds": 172.6,
      "raw_text": "وَأَمْدَدْنَاهُمْ بِفَاكِهَةٍ وَلَحْمٍ مِمَّا يَشْتَهُونَ"
    },
    {
      "chunk": 23,
      "chunk_start_time_seconds": 181.624,
      "raw_text": "يَتَنَازَعُونَ فِيهَا كَأْسًا"
    },
    {
      "chunk": 24,
      "chunk_start_time_seconds": 184.376,
      "raw_text": "بَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُونٌٌ"
    },
    {
      "chunk": 25,
      "chunk_start_time_seconds": 200.632,
      "raw_text": "وَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ قَالُوا إِنَّا كُنَّا قَبْلُ فِي أَهْلِنَا مُشْفِقِينَ"
    },
    {
      "chunk": 26,
      "chunk_start_time_seconds": 220.376,
      "raw_text": "فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ"
    },
    {
      "chunk": 27,
      "chunk_start_time_seconds": 236.6,
      "raw_text": "إِنَّهُ هُوَ الْبَرُّ الرَّحِي"
    },
    {
      "chunk": 28,
      "chunk_start_time_seconds": 242.776,
      "raw_text": "إِنَّهُ ه الْبَرُّ الرَّحِي"
    },
    {
      "chunk": 29,
      "chunk_start_time_seconds": 250.36,
      "raw_text": "فَذَكِّرْ فَمَا أَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ"
    },
    {
      "chunk": 30,
      "chunk_start_time_seconds": 260.792,
      "raw_text": "أَمْ يَقُولُونَ شَاعِرٌ نَتَرَبَّصُ بِهِ رَيْبَ الْمَنُونِ"
    },
    {
      "chunk": 31,
      "chunk_start_time_seconds": 268.664,
      "raw_text": "أَمْ يَقُولُونَ شَاعِرٌ نَّتَرَبَّصُ بِهِ رَيْبَ الْمَنُونِون"
    },
    {
      "chunk": 32,
      "chunk_start_time_seconds": 276.504,
      "raw_text": "قُلْ تَرَبَّصُوا فَإِنِّي مَعَكُم مِّنَ الْمُتَرَبِّصِينَ أَمْ تَأْمُرُهُمْ أَحْلَامُُهُ بِهَذَا أَمْ هُمْ قَوْمٌ طَاغُونَ أَمْ يَقُولُونَ تَقَوَّلَهُ"
    },
    {
      "chunk": 33,
      "chunk_start_time_seconds": 298.136,
      "raw_text": "بَلْ لَا يُؤْمِنُونَ"
    },
    {
      "chunk": 34,
      "chunk_start_time_seconds": 302.04,
      "raw_text": "فَلْيَأْتُوا بِحَدِيثٍ مِثْلِهِ إِنْ كَانُوا صَادِقِينَ"
    },
    {
      "chunk": 35,
      "chunk_start_time_seconds": 311.8,
      "raw_text": "أَمْ خُلِقُوا مِنْ غَيْرِ شَيْءٍ أَمْ هُمُ الْخَالِقُونَ أَمْ خَلَقُوا السَّمَاوَاتِ وَالْأَرْضَ"
    },
    {
      "chunk": 36,
      "chunk_start_time_seconds": 322.456,
      "raw_text": "بَلْ لَا يُوقِنُونَ"
    },
    {
      "chunk": 37,
      "chunk_start_time_seconds": 325.848,
      "raw_text": "أَمْ عِندَهُمْ خَزَائِنُ رَبِّكَ أَمْ هُمُ الْمُصَيْطِرُونَ"
    },
    {
      "chunk": 38,
      "chunk_start_time_seconds": 334.776,
      "raw_text": "أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ"
    },
    {
      "chunk": 39,
      "chunk_start_time_seconds": 341.4,
      "raw_text": "فَلْيَأْتِ مُسْتَمِعُهُمْ بِسُلْطَانٍ مُّبِينٍ أَمْ لَهُ الْبَنَاتُ وَلَكُمُ الْبَنُونَُونَ"
    },
    {
      "chunk": 40,
      "chunk_start_time_seconds": 354.2,
      "raw_text": "أَمْ تَسْأَلُهُمْ أَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَ"
    },
    {
      "chunk": 41,
      "chunk_start_time_seconds": 362.328,
      "raw_text": "أَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ"
    },
    {
      "chunk": 42,
      "chunk_start_time_seconds": 368.152,
      "raw_text": "أَمْ يُرِيدُونَ كَيْدًا"
    },
    {
      "chunk": 43,
      "chunk_start_time_seconds": 371.384,
      "raw_text": "فَالَّذِينَ كَفَرُوا هُمُ الْمَكِيدُونَ أَم لَهُمْ إِلَهٌ غَيْرُ اللَّهِ"
    },
    {
      "chunk": 44,
      "chunk_start_time_seconds": 383.48,
      "raw_text": "سُبْحَانَ اللَّهِ عَمَّا يُشْرِك"
    },
    {
      "chunk": 45,
      "chunk_start_time_seconds": 389.592,
      "raw_text": "وَإِن يَرَوْا كِسْفًا مِّنَ السَّمَاءِ سَاقِطًا يَقُولُوا سَحَابٌ مَرْكُومٌ"
    },
    {
      "chunk": 46,
      "chunk_start_time_seconds": 402.392,
      "raw_text": "فذوْهُمْ حتَّم"
    },
    {
      "chunk": 47,
      "chunk_start_time_seconds": 403.832,
      "raw_text": "حَتَّى يُلَاقُوا يَوْمَهُمُ الَّذِي فِيهِ يُصْعَقُونَ يَوْمَ لَا يُغْنِي عَنْهُمْ كَيْدُهُمْ شَيْئًا وَلَا هُمْ يُنصَرُونَ"
    },
    {
      "chunk": 48,
      "chunk_start_time_seconds": 419.832,
      "raw_text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَلِكَ"
    },
    {
      "chunk": 49,
      "chunk_start_time_seconds": 426.328,
      "raw_text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَلِكَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"
    },
    {
      "chunk": 50,
      "chunk_start_time_seconds": 440.6,
      "raw_text": "وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا"
    },
    {
      "chunk": 51,
      "chunk_start_time_seconds": 447.128,
      "raw_text": "وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُو"
    },
    {
      "chunk": 52,
      "chunk_start_time_seconds": 454.488,
      "raw_text": "وَمِنَ اللَّيْلِ فَسَبِّْ"
    },
    {
      "chunk": 53,
      "chunk_start_time_seconds": 456.6,
      "raw_text": "وَسَبِّحْهُ وَإِدْبَارَ النُّجُومِ"
    }
  ]
}